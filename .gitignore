# --- EAGLE / PCB design editor: ignore common backup / version / temp files ---
# Many Eagle versions create backup/version files containing the character "#" (e.g. Controller.b#1, tactilePop.s#1)
# Ignore any file with a '#' in the filename (these are typically version/backup files)
*#*

# Common Eagle backup/temp suffixes
*.bak
*.bak~
*.sch-bak
*.brd-bak

# Some CAM / job temporary files
*.job
*.pro~

# If you prefer to keep CAM/job/pro files tracked, remove the above lines that match *.job or *.pro~
